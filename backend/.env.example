DATABASE_URL=postgresql://docente:docente_dev@localhost:5432/docente
# Optional local mode without Docker: DATABASE_DRIVER=pglite
DATABASE_DRIVER=postgres
PGLITE_PATH=./data/postgres
PORT=4000
APP_ORIGIN=http://localhost:3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
STORAGE_DRIVER=local
STORAGE_PATH=./storage
# Private Cloudinary originals: STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional image model; text models are not assumed to support image generation.
GEMINI_IMAGE_MODEL=
# Optional separate key for image generation; otherwise GEMINI_API_KEY is used.
GEMINI_IMAGE_API_KEY=
# Transactional email bridge for password recovery.
MAIL_DELIVERY_URL=
MAIL_DELIVERY_TOKEN=
AI_MAX_CONCURRENCY=2
# Pace text calls below a 15 RPM provider quota, including page retries.
AI_TEXT_REQUESTS_PER_MINUTE=12
# S3 compatible: change STORAGE_DRIVER=s3 and fill these values.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=docente
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optional ClamAV HTTP scanner; production requires a scanner.
SCAN_URL=
AI_DAILY_REQUEST_LIMIT=100
STORAGE_LIMIT_MB=500
