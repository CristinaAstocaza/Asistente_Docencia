    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "cookie-parser": "^1.4.7",
    "docx": "^9.0.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.9.0",
    "multer": "^2.0.2",
    "pdfjs-dist": "^6.4.299",
    "pdfkit": "^0.17.0",
